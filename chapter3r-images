# ---- 6a. Plot style, colours, output folder ----------------------------------
theme_set(theme_classic(base_size = 20) +
            theme(axis.title = element_text(face = "bold"),
                  strip.background = element_blank(),
                  strip.text = element_text(face = "bold", hjust = 0),
                  plot.caption = element_text(hjust = 0, size = 14),
                  plot.caption.position = "plot"))
BLUE <- "#2C7FB8"; RED <- "#D7301F"; PURPLE <- "#7B3294"; GREY <- "grey50"

outdir <- "poster_figs"
dir.create(outdir, showWarnings = FALSE)

# cairo_pdf embeds fonts. If Cairo is not available on your computer, fall back
# to plain pdf.
pdf_device <- if (isTRUE(capabilities("cairo"))) cairo_pdf else pdf

save_fig <- function(p, name, w = 11, h = 7) {
  ggsave(file.path(outdir, paste0(name, ".pdf")), p,
         width = w, height = h, device = pdf_device)
}

# ---- 6b. Six figures for one distance ----------------------------------------
make_figures <- function(dat, distance, out) {

  prefix <- gsub(" ", "", distance)             # "12 m" -> "12m" for file names
  tab <- out$tab; loo <- out$loo; res <- out$res

  groups <- dat %>% uncount(n) %>% mutate(yr = year - 2018)
  yrs    <- sort(unique(groups$year))
  n_yrs  <- length(yrs)
  n_tot  <- nrow(groups)

  # Refit the survey-day models (needed for the fitted lines) and the weighted fit
  y_size   <- glm(total ~ yr + offset(log(n_groups)), family = quasipoisson, data = tab)
  y_single <- glm(cbind(k, n_groups - k) ~ yr,        family = quasibinomial, data = tab)
  m_w      <- lm(mean_size ~ yr, data = tab, weights = n_groups)
  ty       <- qt(0.975, df.residual(y_size))
  d_size   <- max(1, summary(y_size)$dispersion)    # dispersion not allowed below 1
  d_single <- max(1, summary(y_single)$dispersion)

  # Labels (must match the ones used in the results table)
  oS <- "Mean group size (rate ratio per year)"
  oO <- "Single-animal group (odds ratio per year)"
  G  <- paste0("Groups as units (n = ", n_tot, ")")
  M  <- paste0("Mixed model, year random (n = ", n_tot, ")")
  Y  <- paste0("Survey days as units (n = ", n_yrs, ")")

  loo <- loo %>%
    mutate(sig       = ifelse(p < 0.05, "p < 0.05", "p >= 0.05"),
           dropped_f = factor(dropped, levels = yrs),
           label     = ifelse(p < 0.01, sprintf("p=%.3f", p), sprintf("p=%.2f", p)))

  bubble <- scale_size_area(max_size = 14, breaks = c(25, 50, 100),
                            name = "Groups observed\n(bubble size)")
  xlab_y <- "Survey year (no survey in 2023)"

  # Fig A: composition of group sizes (percent of groups)
  comp <- groups %>%
    mutate(size_cat = cut(size, breaks = c(0, 1, 2, 3, 5, Inf),
                          labels = c("1", "2", "3", "4-5", "6+"))) %>%
    count(year, size_cat) %>%
    group_by(year) %>% mutate(prop = n / sum(n)) %>% ungroup() %>%
    mutate(year_f = factor(year, levels = yrs))

  figA <- ggplot(comp, aes(year_f, prop, fill = size_cat)) +
    geom_col(width = 0.8, colour = "white") +
    geom_text(aes(label = ifelse(prop >= 0.08, scales::percent(prop, accuracy = 1), ""),
                  colour = size_cat),
              position = position_stack(vjust = 0.5), size = 5) +
    geom_text(data = tab %>% mutate(year_f = factor(year, levels = yrs)),
              aes(year_f, 1.04, label = paste0("n=", n_groups)),
              inherit.aes = FALSE, size = 5) +
    scale_fill_manual(values = c("1" = "#d9f0f7", "2" = "#9ecae1", "3" = "#4aa3c4",
                                 "4-5" = "#2b6f99", "6+" = "#0b2e4f"),
                      name = "Group size") +
    scale_colour_manual(values = c("1" = "black", "2" = "black", "3" = "white",
                                   "4-5" = "white", "6+" = "white"), guide = "none") +
    scale_y_continuous(labels = scales::percent, breaks = seq(0, 1, 0.25),
                       limits = c(0, 1.08), expand = c(0, 0)) +
    labs(x = xlab_y, y = "Percent of groups",
         caption = paste0("Groups defined at ", distance))
  save_fig(figA, paste0(prefix, "_figA_composition"))

  # Fig B: every group observed
  set.seed(1)
  figB <- ggplot(groups, aes(factor(year, levels = yrs), size)) +
    geom_jitter(width = 0.27, height = 0.15, alpha = 0.3, size = 3, colour = BLUE) +
    stat_summary(fun = mean, geom = "point", shape = 18, size = 8, colour = "black") +
    scale_y_continuous(breaks = c(1, 2, 4, 6, 8, 10, 12, 14)) +
    labs(x = xlab_y, y = "Group size (animals)",
         caption = str_wrap(paste0("Each dot is one group; black diamonds = yearly means. Groups defined at ", distance), 85))
  save_fig(figB, paste0(prefix, "_figB_all_groups"))

  # Fig C: mean group size with survey-day GLM fit
  grid <- data.frame(yr = seq(min(tab$yr), max(tab$yr), length.out = 100), n_groups = 1)
  pr   <- predict(y_size, grid, type = "link", se.fit = TRUE, dispersion = d_size)
  grid <- grid %>% mutate(year = yr + 2018, fit = exp(pr$fit),
                          lwr = exp(pr$fit - ty * pr$se.fit),
                          upr = exp(pr$fit + ty * pr$se.fit))
  rs <- res %>% dplyr::filter(outcome == oS, grepl("^Survey", level))

  figC <- ggplot() +
    geom_ribbon(data = grid, aes(year, ymin = lwr, ymax = upr),
                fill = "grey70", alpha = 0.35) +
    geom_line(data = grid, aes(year, fit), linewidth = 1.3) +
    geom_errorbar(data = tab, aes(year, ymin = mean_size - se, ymax = mean_size + se),
                  width = 0.2, linewidth = 1) +
    geom_point(data = tab, aes(year, mean_size, size = n_groups), colour = BLUE) +
    geom_text(data = tab, aes(year, mean_size + se + 0.15, label = paste0("n=", n_groups)),
              size = 5) +
    bubble +
    scale_x_continuous(breaks = yrs) +
    coord_cartesian(ylim = c(0.5, max(tab$mean_size + tab$se) + 0.5)) +
    theme(legend.position = "right") +
    labs(x = "Survey year", y = "Mean group size (+/- SE)",
         caption = str_wrap(sprintf("Survey-day GLM: rate ratio %.3f per year (95%% CI %.2f to %.2f), p = %.3f, n = %d survey days. Groups defined at %s.",
                           rs$est, rs$lo, rs$hi, rs$p, n_yrs, distance), 85))
  save_fig(figC, paste0(prefix, "_figC_mean_size"))

  # Fig D: proportion of single-animal groups with survey-day GLM fit
  grid2 <- data.frame(yr = seq(min(tab$yr), max(tab$yr), length.out = 100))
  pq    <- predict(y_single, grid2, type = "link", se.fit = TRUE, dispersion = d_single)
  grid2 <- grid2 %>% mutate(year = yr + 2018, fit = plogis(pq$fit),
                            lwr = plogis(pq$fit - ty * pq$se.fit),
                            upr = plogis(pq$fit + ty * pq$se.fit))
  rq <- res %>% dplyr::filter(outcome == oO, grepl("^Survey", level))

  figD <- ggplot() +
    geom_ribbon(data = grid2, aes(year, ymin = lwr, ymax = upr),
                fill = "grey70", alpha = 0.35) +
    geom_line(data = grid2, aes(year, fit), linewidth = 1.3) +
    geom_errorbar(data = tab,
                  aes(year, ymin = pmax(0, prop - se_prop), ymax = pmin(1, prop + se_prop)),
                  width = 0.2, linewidth = 1) +
    geom_point(data = tab, aes(year, prop, size = n_groups), colour = BLUE) +
    geom_text(data = tab,
              aes(year, pmin(1, prop + se_prop) + 0.05, label = paste0("n=", n_groups)),
              size = 5) +
    bubble +
    scale_x_continuous(breaks = yrs) +
    scale_y_continuous(labels = scales::percent, limits = c(0, 1.08),
                       breaks = seq(0, 1, 0.25)) +
    theme(legend.position = "right") +
    labs(x = "Survey year", y = "Percent single-animal groups",
         caption = str_wrap(sprintf("Survey-day GLM: odds ratio %.2f per year (95%% CI %.2f to %.2f), p = %.3f, n = %d survey days. Groups defined at %s.",
                           rq$est, rq$lo, rq$hi, rq$p, n_yrs, distance), 85))
  save_fig(figD, paste0(prefix, "_figD_singletons"))

  # Fig E: forest plot - same question answered three ways
  fe <- res %>% mutate(level = factor(level, levels = rev(c(G, M, Y))))
  figE <- ggplot(fe, aes(est, level, colour = level)) +
    geom_vline(xintercept = 1, linetype = "dashed", linewidth = 1) +
    geom_pointrange(aes(xmin = lo, xmax = hi), linewidth = 1.6, size = 1.1) +
    facet_wrap(~outcome, ncol = 1, scales = "free") +
    scale_colour_manual(values = setNames(c(BLUE, PURPLE, RED), c(G, M, Y)), guide = "none") +
    labs(x = "Change per year (1 = no change)", y = NULL,
         caption = paste0("Groups defined at ", distance))
  save_fig(figE, paste0(prefix, "_figE_forest"), w = 11, h = 8.5)

  # Fig F: leave-one-year-out
  figF <- ggplot(loo, aes(dropped_f, slope, colour = sig)) +
    geom_hline(yintercept = 0, linetype = "dashed", linewidth = 1) +
    geom_hline(yintercept = coef(m_w)[["yr"]], linetype = "dotted",
               colour = GREY, linewidth = 1) +
    geom_point(size = 7) +
    geom_text(aes(y = slope - 0.012, label = label), colour = "black", size = 5) +
    annotate("text", x = n_yrs + 0.4, y = coef(m_w)[["yr"]] + 0.006,
             label = "All years", colour = GREY, size = 5, hjust = 1) +
    scale_colour_manual(values = c("p < 0.05" = RED, "p >= 0.05" = BLUE), name = NULL) +
    coord_cartesian(ylim = c(-0.2, 0.05)) +
    labs(x = "Survey year left out", y = "Slope of mean size per year",
         caption = paste0("Groups defined at ", distance))
  save_fig(figF, paste0(prefix, "_figF_leave_one_out"))

  invisible(NULL)
}

# ---- 6c. Make the figures for both thresholds ---------------------------------
make_figures(dat12, "12 m", out12)
make_figures(dat22, "22 m", out22)

# ---- 6d. 12 m vs 22 m comparison figure ---------------------------------------
cmp <- all_res %>%
  mutate(basis = case_when(grepl("^Groups", level)  ~ "Groups as units",
                           grepl("^Mixed", level)   ~ "Mixed model (year random)",
                           TRUE                     ~ "Survey days as units"),
         basis = factor(basis, levels = c("Groups as units", "Mixed model (year random)",
                                          "Survey days as units")))

figG <- ggplot(cmp, aes(est, distance, colour = basis)) +
  geom_vline(xintercept = 1, linetype = "dashed", linewidth = 1) +
  geom_pointrange(aes(xmin = lo, xmax = hi), linewidth = 1.4, size = 0.9,
                  position = position_dodge(width = 0.6)) +
  facet_wrap(~outcome, ncol = 1, scales = "free_x") +
  scale_colour_manual(values = c("Groups as units" = BLUE,
                                 "Mixed model (year random)" = PURPLE,
                                 "Survey days as units" = RED), name = NULL) +
  theme(legend.position = "bottom") +
  labs(x = "Change per year (1 = no change)", y = "Grouping threshold")
save_fig(figG, "figG_comparison_12m_vs_22m", w = 11, h = 8)

